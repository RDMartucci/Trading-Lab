{
  "name": "trading-lab-backend",
  "version": "0.1.0",
  "description": "Backend API for Trading Lab",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose --env-file ../.env -f ../compose.yaml up -d postgres",
    "dev": "npm run db:up && tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "echo \"Tests not configured yet\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
